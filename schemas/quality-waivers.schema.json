{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nosey skill quality waivers v1",
  "description": "Reviewed exceptions for one skill and one pinned commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "waivers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "commit",
          "applies_to",
          "reason",
          "reviewed_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "fail",
                "not_evaluated"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 500
          },
          "reviewed_by": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
